# ---------------------------------------------------------------------------
# Secrets and local environment configuration
# Keep the documented example files, never commit real credentials.
.env

!.env.example

# Demo-only configuration and tooling
.env.demo
.env.demo.*
.env.public-demo
docker-compose.public-demo.yml
/backend/app/seed_demo.py
/scripts/start-public-demo.sh
/scripts/public-demo-status.sh
/scripts/stop-public-demo.sh
CLOUDFLARE_R2_BACKUP.md
